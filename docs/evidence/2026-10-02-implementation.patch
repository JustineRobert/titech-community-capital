-function resolveBootstrapInitializer(
-  moduleValue,
-  options = {},
-) {
-  const {
-    includeLoad = false,
-    includeMount = false,
-    includeRegister = false,
-  } = options;
-
-  if (
-    typeof moduleValue ===
-    "function"
-  ) {
-    return moduleValue;
-  }
-
-  if (
-    !moduleValue ||
-    typeof moduleValue !==
-      "object"
-  ) {
-    return null;
-  }
-
-  const candidates = [
-    moduleValue.initialize,
-    moduleValue.bootstrap,
-    moduleValue.start,
-  ];
-
-  if (includeLoad) {
-    candidates.push(
-      moduleValue.load,
-    );
-  }
-
-  if (includeMount) {
-    candidates.push(
-      moduleValue.mount,
-    );
-  }
-
-  if (includeRegister) {
-    candidates.push(
-      moduleValue.register,
-      moduleValue.registerMiddleware,
-      moduleValue.registerRoutes,
-    );
-  }
-
-  candidates.push(
-    moduleValue.default,
-  );
-
-  for (
-    const candidate of candidates
-  ) {
-    if (
-      typeof candidate ===
-      "function"
-    ) {
-      return candidate;
-    }
-  }
-
-  if (
-    moduleValue.default &&
-    typeof moduleValue.default ===
-      "object" &&
-    moduleValue.default !==
-      moduleValue
-  ) {
-    return resolveBootstrapInitializer(
-      moduleValue.default,
-      options,
-    );
-  }
-
-  return null;
-}
