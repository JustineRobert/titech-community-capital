+APP_NAME=TITech Community Capital
+APP_VERSION=2026.10
+SERVICE_NAME=titech-community-capital-backend
+HOST=0.0.0.0
+PORT=5000
+
+# MongoDB (replica set / TLS configuration supplied by deployment platform)
+MONGO_URI=mongodb://CHANGE_ME/community_savings?replicaSet=CHANGE_ME
