+MTN_PROVIDER_ENABLED=false
+MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
+MTN_MOMO_API_USER=__MANAGED_SECRET__
+MTN_MOMO_API_KEY=__MANAGED_SECRET__
+MTN_MOMO_SUBSCRIPTION_KEY=__MANAGED_SECRET__
+MTN_MOMO_CALLBACK_URL=https://CHANGE_ME/api/v1/payments/mtn/callback
+MTN_MOMO_WEBHOOK_SECRET=__MANAGED_SECRET__
+MOMO_ENV=sandbox
+
+AIRTEL_PROVIDER_ENABLED=false
+MPESA_PROVIDER_ENABLED=false
+BANK_PROVIDER_ENABLED=false
+
+# Webhook / operational secrets
+TITECH_WEBHOOK_SECRET_ENCRYPTION_KEY=__MANAGED_SECRET__
+TITECH_PAYROLL_PROVIDER_WEBHOOK_SECRET=__MANAGED_SECRET__
+TITECH_PAYROLL_WEBHOOK_REQUIRE_SIGNATURE=true
+
+# Financial safety switches
+TITECH_SAAS_BILLING_STAGE_01D_ENABLED=false
+TITECH_SAAS_BILLING_CANONICAL_WRITE_ENABLED=false
