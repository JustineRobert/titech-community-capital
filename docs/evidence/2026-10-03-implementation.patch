+# Redis (TLS/auth configuration supplied by deployment platform)
+REDIS_URL=redis://CHANGE_ME:6379
+REDIS_TLS=false
+
+# Authentication / sessions — managed-secret references in production
+JWT_SECRET=__MANAGED_SECRET__
+JWT_REFRESH_SECRET=__MANAGED_SECRET__
+SESSION_SECRET=__MANAGED_SECRET__
+JWT_ALGORITHM=HS256
+JWT_ISSUER=__MANAGED_VALUE__
+JWT_AUDIENCE=__MANAGED_VALUE__
+
+# Browser/API boundaries
+CLIENT_ORIGIN=https://CHANGE_ME
+CORS_ORIGINS=https://CHANGE_ME
+API_PREFIX=/api/v1
+TENANCY_MODE=required
+
+# Regional defaults
+DEFAULT_COUNTRY_CODE=UG
+DEFAULT_CURRENCY=UGX
+DEFAULT_TIMEZONE=Africa/Kampala
+
+# Observability
+LOG_LEVEL=info
+METRICS_PREFIX=titech
+METRICS_PATH=/metrics
+OTEL_SERVICE_NAME=titech-community-capital-backend
+SENTRY_DSN=
+
+# Provider controls — enable only after partner certification and protected
