# TITech Community Capital frontend runtime contract
# Use a backend origin, not a versioned /api/v1 suffix. Feature endpoints
# own their canonical namespaces (/api/auth, /api/v1/*, etc.).
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=
VITE_API_READINESS_PATH=/api/v1/ready
VITE_API_HEALTH_PATH=/api/v1/health
VITE_SOCKET_URL=http://localhost:5000
VITE_API_RETRIES=2
VITE_API_RETRY_DELAY=1000
VITE_API_HEALTH_TIMEOUT=2500
VITE_REQUEST_TIMEOUT=30000
VITE_ENABLE_SW=false
