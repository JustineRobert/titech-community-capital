# TITech Community Capital — same-origin production frontend contract
# Organization: TITECH CAPITAL - SMC LTD
# TEMPLATE ONLY. Browser-exposed VITE_* variables are public; never put secrets here.
# The Vercel project must also define server-side TITECH_API_ORIGIN (not VITE_*),
# set to the HTTPS origin of the approved TITech backend, e.g. https://api.example.ug.
# Do not include an API path, credentials, query string or trailing path segment.
VITE_API_URL=/api/v1
VITE_API_BASE_URL=
VITE_API_READINESS_PATH=/api/v1/ready
VITE_API_HEALTH_PATH=/api/v1/health
# Configure WebSocket connectivity separately; the serverless HTTP API bridge does not proxy WebSockets.
VITE_SOCKET_URL=/
VITE_API_RETRIES=2
VITE_API_RETRY_DELAY=1000
VITE_API_HEALTH_TIMEOUT=2500
VITE_REQUEST_TIMEOUT=30000
VITE_ENABLE_SW=false
