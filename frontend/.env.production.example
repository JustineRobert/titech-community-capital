VITE_API_READINESS_PATH=/api/v1/ready
VITE_API_HEALTH_PATH=/api/v1/health
VITE_SOCKET_URL=/
VITE_API_RETRIES=2
VITE_API_RETRY_DELAY=1000
VITE_API_HEALTH_TIMEOUT=2500
VITE_REQUEST_TIMEOUT=30000
VITE_ENABLE_SW=false
