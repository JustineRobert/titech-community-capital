{
  "name": "titech-community-capital",
  "version": "1.0.0",
  "description": "TITech Community Capital \u2014 Community Financial Infrastructure Layer for Africa: trusted community financial records, provider-neutral payment orchestration, ledger and reconciliation controls, consented data, risk intelligence and permissioned capital connectivity.",
  "private": true,
  "keywords": [
    "TITech",
    "TITech Community Capital",
    "community finance",
    "community savings",
    "group management",
    "contributions",
    "ledger",
    "double-entry accounting",
    "payments",
    "reconciliation",
    "lending",
    "risk",
    "fraud",
    "KYC",
    "AML",
    "compliance",
    "USSD",
    "offline finance",
    "APIs",
    "analytics",
    "financial infrastructure",
    "financial partner connectivity",
    "SACCO",
    "VSLA",
    "cooperative",
    "microfinance",
    "Africa fintech",
    "fintech"
  ],
  "homepage": "https://github.com/JustineRobert/titech-community-capital#readme",
  "bugs": {
    "url": "https://github.com/JustineRobert/titech-community-capital/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustineRobert/titech-community-capital.git"
  },
  "license": "ISC",
  "author": "Igune Justine Robert, TITech Community Capital LTD",
  "type": "module",
  "main": "backend/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "backend": "npm run dev:backend",
    "build": "npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "check": "npm run check:conflicts && npm run titech:implementation-gate && npm run titech:hosting-gate && npm run validate:syntax && npm run check:financial && npm run check:enterprise-contracts && npm run check:runtime-imports && npm run lint && npm run format:check",
    "check:all": "npm run check && npm run test",
    "check:conflicts": "node scripts/check-conflicts.js",
    "check:enterprise-contracts": "node scripts/enterprise-contract-contracts.mjs",
    "check:financial": "node scripts/financial-static-gate.mjs",
    "check:runtime-imports": "node scripts/runtime-import-audit.mjs",
    "check:structure": "node scripts/enterprise-gate.mjs --structure",
    "ci": "npm run check && npm run test:ci && npm run build",
    "clean": "node scripts/clean.js",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "enterprise:gate": "node scripts/enterprise-gate.mjs --all",
    "enterprise:remediation:gate": "node scripts/enterprise-remediation-gate.mjs --all",
    "format": "npm --prefix backend run format && npm --prefix frontend run format",
    "format:check": "npm --prefix backend run format:check && npm --prefix frontend run format:check",
    "frontend": "npm run dev:frontend",
    "health": "npm --prefix backend run health",
    "health:backend": "npm --prefix backend run health",
    "install:all": "npm ci && npm --prefix backend ci && npm --prefix frontend ci",
    "install:script": "bash scripts/setup.sh",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm --prefix backend run lint",
    "lint:fix": "npm --prefix backend run lint:fix && npm --prefix frontend run lint:fix",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:root": "node scripts/enterprise-gate.mjs --syntax",
    "outdated": "npm outdated --prefix backend && npm outdated --prefix frontend",
    "postman:test": "node scripts/postman-validate.mjs",
    "postman:test:newman": "npx --yes newman run postman/Community-auth-tests.postman_collection.json -e postman/Group-env.postman_environment.json --reporters cli",
    "prepare": "node -e \"console.log('Root orchestration package prepared.')\"",
    "preview": "npm --prefix frontend run preview",
    "production:approval-gate": "node scripts/production-approval-gate.mjs",
    "quality": "npm run check:all",
    "release:gate": "node scripts/release-readiness-gate.mjs --audit",
    "release:gate:strict": "node scripts/release-readiness-gate.mjs --strict",
    "security:audit": "npm audit --prefix backend --audit-level=high && npm audit --prefix frontend --audit-level=high",
    "security:audit:fix": "npm audit fix --prefix backend && npm audit fix --prefix frontend",
    "seed-admin": "npm --prefix backend run seed-admin",
    "seed-admin-cli": "node scripts/seed-admin-cli.js",
    "setup": "npm run install:all",
    "start": "npm run dev",
    "start:backend": "npm --prefix backend run start",
    "start:frontend": "npm --prefix frontend run start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend test",
    "test:backend:ci": "npm --prefix backend run test:ci",
    "test:backend:coverage": "npm --prefix backend run test:coverage",
    "test:backend:watch": "npm --prefix backend test -- --watch",
    "test:ci": "npm run test:backend:ci && npm run test:frontend:ci",
    "test:control-plane": "npm --prefix backend run test:control-plane",
    "test:coverage": "npm run test:backend:coverage && npm run test:frontend:coverage",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:frontend": "npm --prefix frontend test",
    "test:frontend:ci": "npm --prefix frontend run test:ci",
    "test:frontend:coverage": "npm --prefix frontend run test:coverage",
    "test:frontend:watch": "npm --prefix frontend test -- --watch",
    "test:integration": "npm --prefix backend run test:integration",
    "test:providers": "npm --prefix backend run test:providers",
    "test:watch": "npm run test:backend:watch",
    "truth:inventory": "node scripts/repository-truth-inventory.mjs",
    "validate:syntax": "node scripts/enterprise-gate.mjs --syntax",
    "titech:90-day-gate": "node scripts/titech-90-day-readiness-gate.mjs",
    "titech:90-day-gate:strict": "node scripts/titech-90-day-readiness-gate.mjs --strict",
    "titech:production-evidence": "node scripts/production-evidence-package.mjs",
    "titech:hosting-gate": "node scripts/titech-hosting-gate.mjs",
    "audit:modules": "node scripts/esm-cjs-audit.mjs",
    "audit:test-discovery": "node scripts/test-discovery-audit.mjs",
    "test:bootstrap": "npm --prefix backend run test:bootstrap",
    "test:financial": "npm --prefix backend run test:financial",
    "test:commercial": "npm --prefix backend run test:commercial",
    "test:chat": "npm --prefix backend run test:chat",
    "test:all": "npm --prefix backend run test:all",
    "audit:theme": "node scripts/official-theme-audit.mjs",
    "titech:implementation-gate": "node scripts/titech-implementation-gate.mjs",
    "truth:platform": "node scripts/platform-truth.mjs"
  },
  "dependencies": {}
}
