# Runtime
NODE_ENV=development
PORT=5000
HOST=localhost

# MongoDB
MONGO_URI=mongodb://localhost:27017/community_savings

# Redis
REDIS_URL=redis://localhost:6379

# Authentication / session secrets — replace in every deployed environment
JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-strong-secret-at-least-32-characters
SESSION_SECRET=replace-with-a-strong-session-secret

# CORS
CLIENT_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Logging / observability
LOG_LEVEL=info
LOG_DIR=./logs
SENTRY_DSN=

# Country / localization defaults; do not hard-code these into domain logic
DEFAULT_COUNTRY_CODE=UG
DEFAULT_CURRENCY=UGX
DEFAULT_TIMEZONE=Africa/Kampala

# Consent / data governance defaults
CONSENT_DEFAULT_EXPIRY_DAYS=365
DATA_RETENTION_POLICY_VERSION=1

# Payment provider configuration is intentionally externalized.
MTN_PROVIDER_ENABLED=false
AIRTEL_PROVIDER_ENABLED=false
MPESA_PROVIDER_ENABLED=false
BANK_PROVIDER_ENABLED=false

# Feature flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RESET=true

# SaaS billing safety switches
TITECH_SAAS_BILLING_STAGE_01D_ENABLED=false
TITECH_SAAS_BILLING_CANONICAL_WRITE_ENABLED=false
TITECH_SAAS_BILLING_ROLLBACK_TO_LEGACY=false

# Payroll / employer webhooks
# 32-byte AES-256-GCM key, encoded as 64 hex chars or base64. Never commit real values.
TITECH_WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-32-byte-hex-key
# Provider callback HMAC secret; production must be provisioned by the provider/gateway.
TITECH_PAYROLL_PROVIDER_WEBHOOK_SECRET=replace-with-provider-webhook-secret
TITECH_PAYROLL_WEBHOOK_REQUIRE_SIGNATURE=false

# TITech Capital LTD — refugee-inclusive onboarding and insurance capability gates
# Explicitly enable only after tenant permissions, key management, privacy/legal review and partner readiness are evidenced.
TITECH_REFUGEE_ONBOARDING_ENABLED=false
TITECH_REFUGEE_PARTNER_ONBOARDING_ENABLED=false
TITECH_INSURANCE_ONBOARDING_ENABLED=false
TITECH_INSURANCE_OPERATIONS_ENABLED=false
# UbuntuFloat Core stores agent hierarchy and explicitly unverified manual position attestations only.
TITECH_UBUNTFLOAT_CORE_ENABLED=false
# Advance, Swap and live money movement stay disabled until partner/legal/provider gates pass.
TITECH_UBUNTFLOAT_ADVANCE_ENABLED=false
TITECH_UBUNTFLOAT_SWAP_ENABLED=false
TITECH_UBUNTFLOAT_LIVE_MONEY_MOVEMENT_ENABLED=false
TITECH_RETIREMENT_SUPPORT_ENABLED=false
# Generate independent 32-byte random keys, base64-encode them, and store only in your secret manager.
TITECH_DOCUMENT_ENCRYPTION_KEY=
TITECH_PRIVATE_DOCUMENT_STORAGE_PATH=
# Internal ClamAV clamd endpoint; uploads fail closed if no scanner is configured or reachable.
TITECH_DOCUMENT_MALWARE_SCANNER_HOST=
TITECH_DOCUMENT_MALWARE_SCANNER_PORT=3310
TITECH_DOCUMENT_MALWARE_SCANNER_TIMEOUT_MS=5000
TITECH_KYC_IDENTIFIER_HMAC_KEY=
# Live provider/settlement processing is blocked; true values cannot enable operations until a canonical adapter exists.
TITECH_INSURANCE_LIVE_PREMIUM_PROCESSING_ENABLED=false
TITECH_INSURANCE_LIVE_FINANCIAL_APPROVED=false

# Optional pension/scheme reference fingerprinting; use a dedicated random 32-byte base64 key. Never reuse the KYC HMAC key.
TITECH_RETIREMENT_REFERENCE_HMAC_KEY=

# Retirement support: configure only after privacy/legal review.
TITECH_RETIREMENT_NOTICE_VERSION=
TITECH_RETIREMENT_PROCESSING_BASIS=

# USSD/offline capabilities remain disabled until provider/device contracts,
# durable idempotency, atomic event+ledger+receipt persistence, reconciliation,
# and external verification have passed their release gates.
TITECH_USSD_ENABLED=false
TITECH_OFFLINE_SYNC_ENABLED=false
TITECH_OFFLINE_RECONCILIATION_ENABLED=false
# Never put device secrets or provider credentials in source control or browser outbox data.

# Optional video meetings (server-side Daily REST API; never use a VITE_ prefix).
# Video remains unavailable until an authorized provider account and credentials are provisioned.
DAILY_API_KEY=
DAILY_DOMAIN=
# Education fundraising and scholarship case/campaign workflow. Off by default;
# does not enable payment collection, custody, refunds or disbursements.
TITECH_EDUCATION_CAMPAIGNS_ENABLED=false
