# Environment: development, production, or staging
NODE_ENV=development

# Server Configuration
PORT=5000
HOST=localhost

# Database Configuration
# MongoDB Connection String (SRV format recommended for MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/community-savings?retryWrites=true&w=majority

# Fallback MongoDB Connection String (Standard URI format)
# Used if SRV connection fails (e.g., DNS issues)
MONGO_URI_FALLBACK=mongodb://localhost:27017/community-savings

# JWT Configuration
# Secret keys for token signing (use strong random strings in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production_min_32_chars

# CORS Configuration
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Email Configuration (if implementing email features)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@communitysavingsapp.com

# Logging Configuration
LOG_LEVEL=debug
LOG_DIR=./logs

# Session Configuration
SESSION_SECRET=your_session_secret_change_in_production

# Feature Flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RESET=true
ENABLE_REFERRALS=true

# Redis (used for job queue, rate limiting, cache)
REDIS_URL=redis://localhost:6379

# Third-party Services (Optional)
# Stripe, PayPal, etc.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Sentry Error Tracking (Optional)
SENTRY_DSN=

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=




# ============================================================================
# TITech SaaS Billing — STAGE 01D
# ============================================================================

# Master enablement
TITECH_SAAS_BILLING_STAGE_01D_ENABLED=false

# Behavioral parity
TITECH_SAAS_BILLING_STAGE_01D_PARITY_ENABLED=true

# Shadow reads
TITECH_SAAS_BILLING_STAGE_01D_SHADOW_READ_ENABLED=false

# Persist reconciliation results
TITECH_SAAS_BILLING_STAGE_01D_RECONCILIATION_ENABLED=false

# FINAL WRITE SWITCH — MUST REMAIN FALSE UNTIL CUTOVER APPROVAL
TITECH_SAAS_BILLING_CANONICAL_WRITE_ENABLED=false

# Emergency rollback
TITECH_SAAS_BILLING_ROLLBACK_TO_LEGACY=false

# Shadow traffic sample rate
TITECH_SAAS_BILLING_SHADOW_SAMPLE_RATE_PERCENT=0

# Shadow execution safety
TITECH_SAAS_BILLING_SHADOW_TIMEOUT_MS=5000

# Maximum differences recorded per result
TITECH_SAAS_BILLING_MAX_DIFFERENCES=100

# Optional explicit canonical service locations
TITECH_CANONICAL_SUBSCRIPTION_SERVICE_PATH=
TITECH_CANONICAL_TENANT_BILLING_SERVICE_PATH=

# Optional explicit legacy locations
TITECH_LEGACY_SUBSCRIPTION_SERVICE_PATH=../modules/subscriptionService
TITECH_LEGACY_TENANT_BILLING_SERVICE_PATH=../services/tenantBillingService