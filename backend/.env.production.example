# TITech Community Capital — production environment contract
# Organization: TITech Capital LTD
# This is a TEMPLATE ONLY. Do not deploy unchanged. Provision every endpoint,
# secret, private-storage path and certificate in the approved secret manager.
# The host must provide a supported Node.js >=24.15.0 runtime and npm >=11.0.0.

# Runtime
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# External managed services. Use TLS and network allowlists; do not use localhost.
MONGO_URI=mongodb+srv://__SET_USERNAME__:__SET_PASSWORD__@__SET_CLUSTER_HOST__/community_savings?retryWrites=true&w=majority
REDIS_URL=rediss://__SET_REDIS_HOST__:__SET_REDIS_PORT__/0
CACHE_KEY_PREFIX=titech:

# Replace these placeholders with separate, randomly generated values in a secret manager.
JWT_SECRET=__SET_UNIQUE_JWT_SECRET_IN_SECRET_MANAGER__
JWT_REFRESH_SECRET=__SET_DISTINCT_REFRESH_SECRET_IN_SECRET_MANAGER__
SESSION_SECRET=__SET_UNIQUE_SESSION_SECRET_IN_SECRET_MANAGER__
ALLOW_INSECURE_AUTH=false
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Audit must remain on and fail closed in production.
AUDIT_ENABLED=true
AUDIT_FAIL_CLOSED=true

# Origins must be restricted to the approved deployment host.
CLIENT_ORIGIN=__SET_APPROVED_HTTPS_ORIGIN__
CORS_ORIGINS=__SET_APPROVED_HTTPS_ORIGIN__

# Payment providers stay disabled until provider-specific evidence and approvals exist.
MTN_PROVIDER_ENABLED=false
AIRTEL_PROVIDER_ENABLED=false
MPESA_PROVIDER_ENABLED=false
BANK_PROVIDER_ENABLED=false

# Refugee/host-community and insurance capabilities: explicitly off pending approvals.
TITECH_REFUGEE_ONBOARDING_ENABLED=false
TITECH_REFUGEE_PARTNER_ONBOARDING_ENABLED=false
TITECH_INSURANCE_ONBOARDING_ENABLED=false
TITECH_INSURANCE_OPERATIONS_ENABLED=false
TITECH_INSURANCE_LIVE_PREMIUM_PROCESSING_ENABLED=false
TITECH_INSURANCE_LIVE_FINANCIAL_APPROVED=false

# UbuntuFloat is limited to disabled-by-default Core observation; no live money movement.
TITECH_UBUNTFLOAT_CORE_ENABLED=false
TITECH_UBUNTFLOAT_ADVANCE_ENABLED=false
TITECH_UBUNTFLOAT_SWAP_ENABLED=false
TITECH_UBUNTFLOAT_LIVE_MONEY_MOVEMENT_ENABLED=false

# Private evidence storage and malware scanning require deployment-time provisioning.
TITECH_PRIVATE_DOCUMENT_STORAGE_PATH=/var/lib/titech/private-documents
TITECH_DOCUMENT_ENCRYPTION_KEY=__SET_UNIQUE_KEY_IN_SECRET_MANAGER__
TITECH_DOCUMENT_MALWARE_SCANNER_HOST=__SET_PRIVATE_CLAMD_HOST__
TITECH_DOCUMENT_MALWARE_SCANNER_PORT=3310
TITECH_DOCUMENT_MALWARE_SCANNER_TIMEOUT_MS=5000
TITECH_KYC_IDENTIFIER_HMAC_KEY=__SET_UNIQUE_HMAC_KEY_IN_SECRET_MANAGER__

# Other capabilities remain disabled until the corresponding gates are passed.
TITECH_RETIREMENT_SUPPORT_ENABLED=false
TITECH_USSD_ENABLED=false
TITECH_OFFLINE_SYNC_ENABLED=false
TITECH_OFFLINE_RECONCILIATION_ENABLED=false
TITECH_EDUCATION_CAMPAIGNS_ENABLED=false
TITECH_SAAS_BILLING_STAGE_01D_ENABLED=false
TITECH_SAAS_BILLING_CANONICAL_WRITE_ENABLED=false
TITECH_SAAS_BILLING_ROLLBACK_TO_LEGACY=false

# Configure telemetry only through approved secret management.
SENTRY_DSN=
